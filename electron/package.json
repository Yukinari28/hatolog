{
  "name": "hatolog",
  "version": "1.0.0",
  "description": "Unofficial Heartopia companion app (wiki, calculators, tracker)",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hatolog.app",
    "productName": "HatoLog",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "protocols": [
      {
        "name": "HatoLog sign-in",
        "schemes": ["hatolog"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
